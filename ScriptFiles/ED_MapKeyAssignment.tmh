//===================================================================================================

//		Throttle Buttons
//		----------------

		
		if (MapKeyProfile == BASIC) {			// 
			MapKey(&MyThrottle, TBTN1, EXEC("fnVPOutput(\"Turn Headlook On, Off\");"));		// 'o' - Thumb button 
		}
		else {
			MapKeyUMD(&MyThrottle, TBTN1, 
				EXEC("fnVPOutput(\"Request docking permission\");"),						// U - 
				EXEC("fnVPOutput(\"Turn Headlook On, Off\");"),								// M - 
				EXEC("fnVPOutput(\"not used\");")											// D - 
				);
