
//--------------------------------------------------------------------------------------//
//	CMDR Clicker's Elite Dangerous Enhanced Script - T16000, TWCSThrottle, TFRP Rudder	//
//--------------------------------------------------------------------------------------//

// This file: ED_MapKeyAssignment.tmh ... supports Elite Dangerous (Ascendancy)

// Contains MapKey Statements for all button and switch actions
// Contains MapKey Statements to announce via TextToSpeech and printf to console for each button or switch action (training mode)

// Refer Change Log.txt in parent folder

// LEGEND: 
// ========================================================================
// fnName()								refer to ED_Functions file
// initName()							refer to ED_Initialise file
// stfnName()							refer to ED_StateTracker file
// tgName()								refer to ED_Toggles file
// mName								refer to ED_Macros file
// MapKey statements					refer to ED_MapKeyAssignment file
// Global State and Boolean Defines		refer to ED_ScriptDefines file
// Global Game Key Bind Defines			refer to ED_GameBindings file 
// Global Script Variables				refer to ED_GlobalVars file
// User Config Settings					refer to ED_UserSettings file
// ========================================================================

// Index:	Line		FUNCTION
//			Line 43: 	int MainKeyMap()
//			Line 56:		Joystick Buttons
//			Line 355:		Throttle Buttons 
//			Line 589: 	int TrainingMap()
//			Line 599:		Joystick buttons
//			Line 884:		Throttle buttons

// START

// -------------------------- //
//  KeyMaps for Running Game  //
// -------------------------- //

	// FUNCTION:	This MapKey set is called from fnGameStarted() when we detect Game is running
	
	int MainKeyMap() {

		printf("\x0a\HOTAS Mode:	GAME\x0a");
			
// ---------------------------------------- //
// Map Joystick triggers, switches and hats //
// ---------------------------------------- //

		// Include MapKey for everything.
		// Include MapKeyR only where used.
				
//===================================================================================================

//		Joystick Stick Buttons
//		----------------------

//		(Trigger Switch 1 - Primary Fire)
//		---------------------------------

		if (MapKeyProfile == BASIC) {			// ...use BASIC profile settings	// MapKeyProfile is set within ED_UserSettings.tmh
			MapKeyUMD(&MyJoystick, TS1,
				0,																	// U - 
				PrimaryFire,														// M - DX1 - Trigger
				0																	// D - 
				);			
		}
		else {									// ...use FULL profile settings 
			MapKeyUMD(&MyJoystick, TS1,
				EXEC("tgTriggerMode(1);"),											// U - Increment trigger mode for shifted Primary Fire
				EXEC("fnAdvFireControl(0);"),										// M - Default Primary Fire action
				EXEC("fnAdvFireControl(1);")										// D - Shifted Primary Fire action
				);
			MapKeyRUMD(&MyJoystick, TG1,		// TG1 RELEASE
				0,																	// U -
				PrimaryFire,														// M - Release trigger
				0																	// D -			
				);
		}

//		(Trigger Switch 2 - Secondary Fire)
//		-----------------------------------

		if (MapKeyProfile == BASIC) {			// 
			MapKeyUMD(&MyJoystick, TS2,
				PULSE+HUDMode,														// U - '/' - Switch between Combat and Discovery HUD modes 
				SecondaryFire,														// M - DX2 - Rear Thumb
				PULSE+FSSModeON														// D - LShift+/
				);			
		}
		else {									// 
			MapKeyUMD(&MyJoystick, TS2,
				EXEC("tgTriggerMode(2);"),											// U - Swap trigger action between timed and press-to-fire/press-to-stop
				EXEC("fnAdvFireControl(2);"),										// M - Default Secondary Fire action
				EXEC("fnAdvFireControl(3);")										// D - Shifted Secondary Fire action
				);			
			MapKeyRUMD(&MyJoystick, TS2,		// S2 RELEASE
				0,																	// U -
				SecondaryFire,														// M - Release trigger 
				0																	// D -
				);
		}

//		(Trigger Switch 3 - Flight Assist)
//		----------------------------------
		
		if (MapKeyProfile == BASIC) {			// 
			MapKeyUMD(&MyJoystick, TS3,
				PULSE+SilentRunning,												// U - 'DELETE' - Map "Silent Running" within game binding to TOGGLE		
				PULSE+FlightAssist,													// M - 'z' - Right Thumb - Set Flight Assist to "TOGGLE" in game binding
				PULSE+FBView														// D - LShift+\
				);			
		}
		else {									// 
			MapKeyUMD(&MyJoystick, TS3,
				EXEC("tgEnhancedFAOFF(1);"),										// Engage JSMouseEmulation
				EXEC("tgEnhancedFAOFF(0);"),										// TOGGLE: FA-OFF/ON
				SEQ(EXEC("tgSilentRunning(ON);"), EXEC("tgSilentRunning(OFF);"))	// TOGGLE: Silent Running ON/OFF
				);
		}

//		(Trigger Switch 4 - Hardpoints)
//		-------------------------------
		
		if (MapKeyProfile == BASIC) {			// 
			MapKeyUMD(&MyJoystick, TS4, 
				PULSE+TargetNextSubsystem,											// U - 'i'
				PULSE+DeployHardpoints,												// M - 'u' - Left Thumb
				0 																	// D - 
				);	
		}
		else {									// 
			MapKeyUMD(&MyJoystick, TS4, 
				EXEC("tgHUDMode();"),												// U - Toggle - Analysis/Combat Mode
				EXEC("tgHardpoints();"),											// M - Deploy/Retract Hard-points - Toggles HUD Mode in Supercruise
				EXEC("tgXAxis(SET);")												// D - Toggle Joystick X-Axis between Roll and Yaw
				);
		}
		
//===================================================================================================

//		Joystick POV Hat
//		----------------

		if (MapKeyProfile == BASIC) {			// 
			MapKeyUMD(&MyJoystick, H1U, 
				PULSE+SelectHighestThreat,											// U - 'y'
				PULSE+SelectTargetAhead,											// M - 't'
				PULSE+SelectNextHostileShip											// D - 'h'
				);
		}
		else {
			MapKeyUMD(&MyJoystick, H1U, 
				PULSE+SelectHighestThreat,											// U - 'y'
				PULSE+SelectTargetAhead,											// M - 't'
				PULSE+SelectNextHostileShip											// D - 'h'
				);
		}

		if (MapKeyProfile == BASIC) {			// 		
			MapKeyUMD(&MyJoystick, H1D, 
				PULSE+WingmanTarget,												// U - '5'
				SEQ(PULSE+SelectWingman1,											// M - '8'
					PULSE+SelectWingman2,											//   - '9'
					PULSE+SelectWingman3),											//   - '0'
				PULSE+WingmanNavLock												// D - '6'
				);
		}
		else {
			MapKeyUMD(&MyJoystick, H1D, 
				PULSE+WingmanTarget,												// U - '5'
				SEQ(PULSE+SelectWingman1,											// M - '8'
					PULSE+SelectWingman2,											//   - '9'
					PULSE+SelectWingman3),											//   - '0'
				PULSE+WingmanNavLock												// D - '6'
				);
		}
				
		if (MapKeyProfile == BASIC) {			// 				
			MapKeyUMD(&MyJoystick, H1L, 
				PULSE+CargoScoop,													// U - 'HOME' key 
				PULSE+NextFireGroup,												// M - ',' - comma 
				PULSE+LandingGear													// D - 'l' - lowercase L 
				);
		}
		else {
			MapKeyUMD(&MyJoystick, H1L, 
				EXEC("tgLandingGear(0);"),											// U - Toggle Landing Gear
				PULSE+NextFireGroup,												// M - ',' - comma
				SEQ(EXEC("tgCargoScoop(DEPLOY);"),EXEC("tgCargoScoop(RETRACT);") )	// D - Deploy if retracted, Otherwise Retract 
				);
		}
		
		if (MapKeyProfile == BASIC) {			// 
			MapKeyUMD(&MyJoystick, H1R, 
				PULSE+NightVision,													// U - LeftAlt+'INSERT'
				PULSE+SelectNextShip,												// M - 'g'
				PULSE+ShipLights													// D - 'INSERT' key
				);
		}
		else {
			MapKeyUMD(&MyJoystick, H1R, 
				EXEC("tgLights(OFF);"),												// U - Sequence Lights 
				PULSE+SelectNextShip,												// M - 'g'
				EXEC("tgLights(ON);")												// D - Turn on Night Vision
				);
		}
		
		
//===================================================================================================

//		Joystick Base Buttons
//		---------------------

		if (MapKeyProfile == BASIC) {			// 		
			MapKey(&MyJoystick, B5,  PULSE+GalMap);									// LeftShift+';'
		}
		else {
			MapKeyUMD(&MyJoystick, B5, 
				0,																	// U - 
				PULSE+GalMap,														// LeftShift+';'
				0																	// D -
				);
		}

		if (MapKeyProfile == BASIC) {			// 		
			MapKey(&MyJoystick, B6,  0);											//
		}
		else {
			MapKeyUMD(&MyJoystick, B6,
				0,																	// U - 
				EXEC("fnDRShip();"),												// M - Dismiss or recall the ship when on foot or in SRV 
				0																	// D -
				);
		}

		if (MapKeyProfile == BASIC) {			// 		
			MapKey(&MyJoystick, B7,  PULSE+HideShipGUI);							// LeftCTRL+LeftALT+'g'
		}
		else {
			MapKeyUMD(&MyJoystick, B7,
				0,																	// U - 
				PULSE+HideShipGUI,													// M - LeftCTRL+LeftALT+'g'
				0																	// D -
				);
		}
		
		if (MapKeyProfile == BASIC) {			// 
			// Press B8 to cycle selection of Wingmen
			MapKey(&MyJoystick, B8,  SEQ(	PULSE+SelectWingman1,					// '8' 
											PULSE+SelectWingman2,					// '9'
											PULSE+SelectWingman3					// '0'
										)											// close SEQ 
				);																	// close MapKey
		}
		else {
			MapKeyUMD(&MyJoystick, B8,
				0,																	// U - 
				EXEC("fnHangerServices(ENTER);"),									// M - 
				0																	// D -
				);
		}

		if (MapKeyProfile == BASIC) {			// 		
			MapKey(&MyJoystick, B9,  PULSE+ExtCamera);								// 'NUMPAD 5' - External camera ON/OFF
		}
		else {
			MapKeyUMD(&MyJoystick, B9,
				0,																	// U - 
				EXEC("tgExtCamera();"),												// M - External Camera ON/OFF 
				0																	// D -
				);
		}
		
		if (MapKeyProfile == BASIC) {			// 		
			MapKey(&MyJoystick, B10, PULSE+SystemMap);								// ';'
		}
		else {
			MapKeyUMD(&MyJoystick, B10,
				0,																	// U - 
				PULSE+SystemMap,													// M - ';' 
				0																	// D -
				);
		}
		
		if (MapKeyProfile == BASIC) {			// 
			MapKey(&MyJoystick, B11, PULSE+ShowConnectionStatus);					// 'LCTRL+b' 
		}
		else {
			MapKeyUMD(&MyJoystick, B11,
				0,																	// U - 
				PULSE+m_ShowGameStats,												// M - Show both Frame Rate and Connection Status 
				0																	// D -
				);
		}

		if (MapKeyProfile == BASIC) {			// 
			MapKey(&MyJoystick, B12, 0);											//
		}
		else {
			MapKeyUMD(&MyJoystick, B12,
				0,																	// U - 
				EXEC("fnClearChatBox(0);"),											// M - Clear the COMMS panel chat box
				0																	// D -
				);
		}

		if (MapKeyProfile == BASIC) {			// 
			MapKey(&MyJoystick, B13, 0);											//
		}
		else {
			MapKeyUMD(&MyJoystick, B13,
				0,																	// U - 
				SEQ(PULSE+m_NAVBeaconWing, PULSE+m_NAVBeaconOff),					// M - My NAV Beacon - ON/OFF
				0																	// D -
				);
		}
		
		if (MapKeyProfile == BASIC) {			// 
			MapKey(&MyJoystick, B14, 0);
		}
		else {
			MapKeyUMD(&MyJoystick, B14, 
				EXEC("fnSetCurves(MEDIUM,	CurveInfo);"),							// U - Set Curves = MEDIUM
				EXEC("fnSetCurves(OFF,		CurveInfo);"),							// M - Set Curves = OFF
				EXEC("fnSetCurves(SLOWEST,	CurveInfo);")							// D - Set Curves = SLOWEST
				);
		}

		if (MapKeyProfile == BASIC) {			// 
			MapKey(&MyJoystick, B15, 0);											// 
		}
		else {
			MapKeyUMD(&MyJoystick, B15,
				0,																	// U - 
				PULSE+m_ChangeColours,												// M - Change Engine and Weapon Colours
				0																	// D -
				);
		}
		
		if (MapKeyProfile == BASIC) {			// 
			MapKey(&MyJoystick, B16, PULSE+ShowFramerate);							// LCTRL+f 
		}
		else {
			MapKeyUMD(&MyJoystick, B16,
				EXEC("fnModeSwitch(1);"),											// U - Menulog to Private Group
				EXEC("fnModeSwitch(2);"),											// M - Menulog to Solo 
				EXEC("fnModeSwitch(0);")											// D - Menulog to Open 
				);
		}
		
//===================================================================================================

//		Throttle Buttons
//		----------------

		
		if (MapKeyProfile == BASIC) {			// 
			MapKey(&MyThrottle, TBTN1, PULSE+LookOnOff);							// 'o' - thumb button 
		}
		else {
			MapKeyUMD(&MyThrottle, TBTN1, 
				EXEC("fnRequestDock();"),											// U - Fire Req Dock seq macro
				PULSE+LookOnOff,													// M - 'o' - Thumb
				0																	// D - 
				);
		}

		if (MapKeyProfile == BASIC) {			// 
			MapKey(&MyThrottle, TBTN2, 0);												//  ** DO NOT TOUCH ** Used as ShiftButton for UMD - UP 
		}
		else {
			MapKey(&MyThrottle, TBTN2, REXEC(hSoundFX, 3000, "fnSoundFX(\"boop\", 50);", RNOSTOP));	//  ShiftButton: Sound Reminder every 3 seconds
			MapKeyR(&MyThrottle, TBTN2, EXEC("StopAutoRepeat(hSoundFX);"));		//RELEASE			//  Cancel reminder soundfx
		}
		if (MapKeyProfile == BASIC) {			// 
			MapKey(&MyThrottle, TBTN3, 0);												//  ** DO NOT TOUCH ** Used as ShiftButton for UMD - DOWN 
		}
		else {
			MapKey(&MyThrottle, TBTN3, REXEC(hSoundFX, 3000, "fnSoundFX(\"boop\", 50);", RNOSTOP));	//  ShiftButton: Sound Reminder every 3 seconds
			MapKeyR(&MyThrottle, TBTN3, EXEC("StopAutoRepeat(hSoundFX);"));		//RELEASE			//  Cancel reminder soundfx
		}

		if (MapKeyProfile == BASIC) {			// 
			MapKeyUMD(&MyThrottle, TBTN4, 
				0,																	// U - 
				PULSE+EngineBoost,													// M - LeftShift+'b' - Middle Finger UP
				0																	// D - 
				);
		}
		else {
			MapKeyUMD(&MyThrottle, TBTN4, 
				0,																	// U - 
				EXEC("tgBoost();"),													// M - Boost
				EXEC("fnVoiceVolume(INCREASE);")									// D - Increase Text to Speech Volume 
				);
		}
		
		if (MapKeyProfile == BASIC) {			// 
			MapKeyUMD(&MyThrottle, TBTN5, 
				PULSE+SRVHandbrake,													// U - 'x'
				PULSE+ReverseThrottle,												// M - NP '*' - Middle Finger DOWN - set to TOGGLE
				0																	// D - 
				);
		}
		else {
			MapKeyUMD(&MyThrottle, TBTN5, 
				PULSE+SRVHandbrake,													// U - 'x'
				SEQ(EXEC("tgReverseThrust(1);"), EXEC("tgReverseThrust(3);")),		// M - Standard Reverse	- Deploy Speedbrake if Hardpoints deployed
				EXEC("fnVoiceVolume(DECREASE);")									// D - Decrease Text to Speech Volume
				);
		}

		if (MapKeyProfile == BASIC) {			// 
			MapKeyUMD(&MyThrottle, TLOCK, 
				0,																	// U - 
				PULSE+ResetHeadOrientation,											// M - '~' - Slew Control - PRESS 
				0																	// D - 
				);
		}
		else{
			MapKeyUMD(&MyThrottle, TLOCK, 
				0,																	// U - 
				PULSE+ResetHeadOrientation,											// M - '~' - Slew Control - PRESS 
				PULSE+EjectCargo													// D - 'END'
				);
		}

//===================================================================================================

//		Throttle HAT1 - Middle - Travel Management
//		----------------------

		if (MapKeyProfile == BASIC) {			// 
			MapKey(&MyThrottle, THAT1U, PULSE+Supercruise);							// NP '/'	- Numberpad forward slash key 
		}
		else {
			MapKeyUMD(&MyThrottle, THAT1U, 
				EXEC("tgFSSMode();"),												// U - Toggle FSS mode  
				EXEC("tgWarpDrive(0);"),											// M - Toggle: Engage Super-cruise Engine
				PULSE+DSSModeOFF													// D - 'BACKSPACE'
				);		
		}
		
		if (MapKeyProfile == BASIC) {			// 
			MapKey(&MyThrottle, THAT1D, PULSE+HyperJump);							// 'j'
		}
		else {
			MapKeyUMD(&MyThrottle, THAT1D, 
				EXEC("tgPlanetView();"),											// U - Front/Back View
				EXEC("tgWarpDrive(1);"),											// M - Toggle: Initiate Hyper Jump
				0																	// D - 
				);		
		}
		
		if (MapKeyProfile == BASIC) {			// 
			MapKey(&MyThrottle, THAT1L, PULSE+SelectNextSystemInRoute);				// 'm'
		}
		else {
			MapKeyUMD(&MyThrottle, THAT1L, 
				PULSE+FSSZoomOUT,													// U - '['
				PULSE+SelectNextSystemInRoute,										// M - 'm' - Target next system in jump route
				0																	// D - 
				);					
		}
		
		if (MapKeyProfile == BASIC) {			// 
			MapKey(&MyThrottle, THAT1R, PULSE+OrbitLines);							// '='
		}
		else {
			MapKeyUMD(&MyThrottle, THAT1R, 
				PULSE+FSSZoomIN,													// U - ']'
				PULSE+OrbitLines,													// M - '=' - Toggle Orbit Lines ON/OFF 
				0																	// D - 
				);					
		}
		
//===================================================================================================

//		Throttle HAT2 - Top - PIP Management
//		------------------------------------

		if (MapKeyProfile == BASIC) {			// 
			MapKey(&MyThrottle, THAT2U, PULSE+PowerEng);							// LeftShift+UP		arrow key combo		
		}
		else {
			MapKeyUMD(&MyThrottle, THAT2U,
				EXEC("fnPIPMode(INCREASE);"),										// U - Increment PIPMode
				EXEC("fnPIPManager(ENG);"),											// M - Fire Engine focussed PIP sequence
				EXEC("fnPIPMode(DECREASE);")										// D - Decrement PIPMode 
				);					
		}
		if (MapKeyProfile == BASIC) {			// 
			MapKey(&MyThrottle, THAT2D, PULSE+BalancePower);						// LeftShift+DOWN	arrow key combo				
		}
		else {
			MapKeyUMD(&MyThrottle, THAT2D, 	
				EXEC("fnPIPMode(RESET);"),											// U - Reset PIPMode 
				PULSE+BalancePower,													// M - Balance PIP sequence
				0																	// D - 
				);		
		}
		if (MapKeyProfile == BASIC) {			// 
			MapKey(&MyThrottle, THAT2L, PULSE+PowerSys);							// LeftShift+LEFT	arrow key combo		
		}
		else {
			MapKeyUMD(&MyThrottle, THAT2L, 
				PULSE+TargetPrevSubsystem,											// U - 'k'
				EXEC("fnPIPManager(SYS);"),											// M - Fire System focussed PIP sequence
				0																	// D - 
				);		
		}
		if (MapKeyProfile == BASIC) {			// 
			MapKey(&MyThrottle, THAT2R, PULSE+PowerWep);							// LeftShift+RIGHT	arrow key combo	
		}
		else {
			MapKeyUMD(&MyThrottle, THAT2R,
				PULSE+TargetNextSubsystem,											// U - 'i'
				EXEC("fnPIPManager(WEP);"),											// M - Fire Weapon focussed PIP sequence
				0																	// D - 
				);		
		}

//===================================================================================================

//		Throttle HAT3 - Bottom - Countermeasures
//		----------------------------------------

		if (MapKeyProfile == BASIC) {			// 
			MapKey(&MyThrottle, THAT3U, PULSE+UseShieldCell);						// ''' - single quote key 
		}
		else {
			MapKeyUMD(&MyThrottle, THAT3U,
				EXEC("fnAdvancedSCB(2);"),													// U - 'Double Bank" - 1xSCB, 1xHeatsink, 1xSCB
				EXEC("fnAdvancedSCB(0);"), 													// M - Fire Shield Cell Bank
				EXEC("fnAdvancedSCB(1);")													// D - 1xSCB + 1xHeatsink
				);		
		}
		if (MapKeyProfile == BASIC) {			// 
			MapKey(&MyThrottle, THAT3D, PULSE+DeployHeatSink);						// 'v'
		}
		else {
			MapKeyUMD(&MyThrottle, THAT3D,
				EXEC("fnTextToSpeech(\"Not used\");"),								// U -
				EXEC("fnHeatsink();"),												// M - Fire Heat Sink
				EXEC("fnTextToSpeech(\"Not used\");")								// D -
				);		
		}
		if (MapKeyProfile == BASIC) {			// 
			MapKey(&MyThrottle, THAT3L, ChargeECM);									// LeftShift+'c' - press to charge, release to fire
		}
		else {
			MapKeyUMD(&MyThrottle, THAT3L,
				EXEC("fnTextToSpeech(\"Not used\");"),								// U -
				EXEC("ActKey(KEYON+ChargeECM); printf(\"! ECM Charging...\");"),	// M - Charge ECM (Electronic Counter Measures)
				EXEC("fnTextToSpeech(\"Not used\");")								// D -
				);		
			MapKeyRUMD(&MyThrottle, THAT3L,		// RELEASE
				EXEC("fnTextToSpeech(\"Not used\");"),								// RU - 
				EXEC("ActKey(ChargeECM); printf(\"Fired !\\x0a\");"),				// RM - Fire ECM when trigger is released
				EXEC("fnTextToSpeech(\"Not used\");")								// RD - 
				);
		}
		if (MapKeyProfile == BASIC) {			// 
			MapKey(&MyThrottle, THAT3R, PULSE+FireChaff);							// 'c'
		}
		else {
			MapKeyUMD(&MyThrottle, THAT3R,
				EXEC("fnTextToSpeech(\"Not used\");"),								// U -
				EXEC("fnChaff();"),													// M - Fire Chaff
				EXEC("fnTextToSpeech(\"Not used\");")								// D -
				);		
		}

	} 	// End of MainKeyMap 

// =============================================================================================================================================
// =============================================================================================================================================


// --------------------------- //
//  KeyMaps for Training Mode  //
// --------------------------- //

	// FUNCTION:	This MapKey set is called at startup if game is not running and user setting 'TrainingMode' is set to ENABLED in ED_UserSettings.tmh 
	//				Also called from stfnProcessFlags() when we detect Game has halted

	int TrainingMap() {

		printf("\x0a\HOTAS Mode:	TRAINING\x0a");
		
// ---------------------------------------- //
// Map Joystick triggers, switches and hats //
// ---------------------------------------- //

//===================================================================================================

//		Joystick Stick Buttons
//		----------------------

//		(Trigger Switch 1 - Primary Fire)
//		---------------------------------

		if (MapKeyProfile == BASIC) {			// ...use BASIC profile settings								// MapKeyProfile is set within ED_UserSettings.tmh
			MapKeyUMD(&MyJoystick, TS1,
				EXEC("fnVPOutput(\"not used\");"),									// U - 
				EXEC("fnVPOutput(\"Primary Fire\");"),								// M - DX1 - Trigger
				EXEC("fnVPOutput(\"not used\");")									// D - 
				);			
		}
		else {									// ...use FULL profile settings 
			MapKeyUMD(&MyJoystick, TS1,
				EXEC("fnVPOutput(\"Increment trigger mode for primary fire\");"),	// U - 
				EXEC("fnVPOutput(\"Standard primary fire\");"),						// M - 
				EXEC("fnVPOutput(\"Alternate primary fire action\");")				// D - 
				);
		}

//		(Trigger Switch 2 - Secondary Fire)
//		-----------------------------------

		if (MapKeyProfile == BASIC) {			// 
			MapKeyUMD(&MyJoystick, TS2,
				EXEC("fnVPOutput(\"Switch HUD Mode\");"),							// U - '/' - Switch between Combat and Discovery HUD modes 
				EXEC("fnVPOutput(\"Secondary Fire\");"),							// M - DX2 - Rear Thumb
				EXEC("fnVPOutput(\"FSS Mode ON, OFF\");")							// D - LShift+/
				);			
		}
		else {									// 
			MapKeyUMD(&MyJoystick, TS2,
				EXEC("fnVPOutput(\"Increment trigger mode for secondary fire\");"),	// U -
				EXEC("fnVPOutput(\"Standard secondary fire\");"),					// M -
				EXEC("fnVPOutput(\"Alternate secondary fire action\");")			// D -
				);
		}

//		(Trigger Switch 3 - Flight Assist)
//		----------------------------------
		
		if (MapKeyProfile == BASIC) {			// 
			MapKeyUMD(&MyJoystick, TS3,
				EXEC("fnVPOutput(\"Silent Running ON, OFF\");"),					// U - 'DELETE' - Map "Silent Running" within game binding to TOGGLE		
				EXEC("fnVPOutput(\"Flight Assist ON, OFF\");"),						// M - 'z' - Right Thumb - Set Flight Assist to "TOGGLE" in game binding
				EXEC("fnVPOutput(\"FSS planet view front, back toggle\");")			// D - LShift+\
				);			
		}
		else {									// 
			MapKeyUMD(&MyJoystick, TS3,
				EXEC("fnVPOutput(\"Engage mouse flight control\");"),				// U - 
				EXEC("fnVPOutput(\"Flight assist on, off\");"),						// M - 
				EXEC("fnVPOutput(\"Silent running on, off\");")						// D - 
				);
		}

//		(Trigger Switch 4 - Hardpoints)
//		-------------------------------
		
		if (MapKeyProfile == BASIC) {			// 
			MapKeyUMD(&MyJoystick, TS4, 
				EXEC("fnVPOutput(\"Target next subsystem\");"),						// U - 'i'
				EXEC("fnVPOutput(\"Deploy, stow hard points\");"),					// M - 'u' - Left Thumb
				EXEC("fnVPOutput(\"not used\");") 									// D - 
				);	
		}
		else {									// 
			MapKeyUMD(&MyJoystick, TS4, 
				EXEC("fnVPOutput(\"Toggle hud mode\");"),							// U - 
				EXEC("fnVPOutput(\"Deploy, stow hard points\");"),					// M - 
				EXEC("fnVPOutput(\"Toggle yaw, roll on joystick X axis\");")		// D - 
				);
		}
		
//===================================================================================================

//		Joystick POV Hat
//		----------------

		if (MapKeyProfile == BASIC) {			// 
			MapKeyUMD(&MyJoystick, H1U, 
				EXEC("fnVPOutput(\"Select highest threat\");"),						// U - 'y'
				EXEC("fnVPOutput(\"Select target ahead\");"),						// M - 't'
				EXEC("fnVPOutput(\"Select next hostile ship\");")					// D - 'h'
				);
		}
		else {
			MapKeyUMD(&MyJoystick, H1U, 
				EXEC("fnVPOutput(\"Select highest threat\");"),						// U - 'y'
				EXEC("fnVPOutput(\"Select target ahead\");"),						// M - 't'
				EXEC("fnVPOutput(\"Select next hostile ship\");")					// D - 'h'
				);
		}

		if (MapKeyProfile == BASIC) {			// 		
			MapKeyUMD(&MyJoystick, H1D, 
				EXEC("fnVPOutput(\"Select Wingmans Target\");"),					// U - '5'
				EXEC("fnVPOutput(\"Select next wingman\");"),						// M - '8', "9", "0"
				EXEC("fnVPOutput(\"Select Wingmans Nav Lock\");")					// D - '6'
				);
		}
		else {
			MapKeyUMD(&MyJoystick, H1D, 
				EXEC("fnVPOutput(\"Select Wingmans Target\");"),					// U - '5'
				EXEC("fnVPOutput(\"Select next wingman\");"),						// M - '8', "9", "0"
				EXEC("fnVPOutput(\"Select Wingmans Nav Lock\");")					// D - '6'
				);
		}
				
		if (MapKeyProfile == BASIC) {			// 				
			MapKeyUMD(&MyJoystick, H1L, 
				EXEC("fnVPOutput(\"Deploy, retract cargo scoop\");"),				// U - 'HOME' key 
				EXEC("fnVPOutput(\"Increment fire group\");"),						// M - ',' - comma
				EXEC("fnVPOutput(\"Deploy, retract landing gear\");")				// M - 'l' - lowercase L 
				);
		}
		else {
			MapKeyUMD(&MyJoystick, H1L, 
				EXEC("fnVPOutput(\"Deploy, retract landing gear\");"),				// U -
				EXEC("fnVPOutput(\"Increment fire group\");"),						// M - ',' - comma
				EXEC("fnVPOutput(\"Deploy, retract cargo scoop\");")				// D -
				);
		}
		
		if (MapKeyProfile == BASIC) {			// 
			MapKeyUMD(&MyJoystick, H1R, 
				EXEC("fnVPOutput(\"Night Vision On, Off\");"),						// U - LeftAlt+'INSERT'
				EXEC("fnVPOutput(\"Target next ship\");"),							// M - 'g' 
				EXEC("fnVPOutput(\"Lights On, Off\");")								// D - 'INSERT' key 
				);
		}
		else {
			MapKeyUMD(&MyJoystick, H1R, 
				EXEC("fnVPOutput(\"Lights On, Off\");"),							// U - Sequence lights 
				EXEC("fnVPOutput(\"Target next ship\");"),							// M - 'g' 
				EXEC("fnVPOutput(\"Night Vision On, Off\");")						// D - Toggle Nightvision
				);
		}
		
		
//===================================================================================================

//		Joystick Base Buttons
//		---------------------

		if (MapKeyProfile == BASIC) {			// 		
			MapKey(&MyJoystick, B5,  EXEC("fnVPOutput(\"Galaxy Map On, Off\");"));	// LeftShift+';'
		}
		else {
			MapKeyUMD(&MyJoystick, B5,
				EXEC("fnVPOutput(\"not used\");"),									// U -
				EXEC("fnVPOutput(\"Galaxy Map On, Off\");"),						// M - 
				EXEC("fnVPOutput(\"not used\");")									// D -
				);
		}

		if (MapKeyProfile == BASIC) {			// 		
			MapKey(&MyJoystick, B6,  EXEC("fnVPOutput(\"not used\");"));			//
		}
		else {
			MapKeyUMD(&MyJoystick, B6,
				EXEC("fnVPOutput(\"not used\");"),									// U - 
				EXEC("fnVPOutput(\"not used\");"),									// M - 
				EXEC("fnVPOutput(\"not used\");")									// D -
				);
		}

		if (MapKeyProfile == BASIC) {			// 		
			MapKey(&MyJoystick, B7,  EXEC("fnVPOutput(\"Ship GUI Off, On\");"));	// LeftCTRL+LeftALT+'g'
		}
		else {
			MapKeyUMD(&MyJoystick, B7,
				EXEC("fnVPOutput(\"not used\");"),									// U - 
				EXEC("fnVPOutput(\"Ship GUI Off, On\");"),							// M - 
				EXEC("fnVPOutput(\"not used\");")									// D -
				);

		}
		
		if (MapKeyProfile == BASIC) {			// 
			// Press B8 to cycle selection of Wingmen
			MapKey(&MyJoystick, B8,  SEQ(	EXEC("fnVPOutput(\"Select Wing man 1\");"),		// '8' 
											EXEC("fnVPOutput(\"Select Wing man 2\");"),		// '9'
											EXEC("fnVPOutput(\"Select Wing man 3\");")		// '0'
										)													// close SEQ 
				);																			// close MapKey
		}
		else {
			MapKeyUMD(&MyJoystick, B8,
				0,																			// U - 
				EXEC("fnVPOutput(\"Restock and enter hanger services\");"),					// M - 
				0																			// D -
				);		}

		if (MapKeyProfile == BASIC) {			// 		
			MapKey(&MyJoystick, B9,  EXEC("fnVPOutput(\"External camera\");"));				// 'NUMPAD 5'
		}
		else {
			MapKeyUMD(&MyJoystick, B9, 
				EXEC("fnVPOutput(\"not used\");"),											// U -
				EXEC("fnVPOutput(\"External Camera on/off\");"),							// M -
				EXEC("fnVPOutput(\"not used\");")											// D -
				);
		}
		
		if (MapKeyProfile == BASIC) {			// 		
			MapKey(&MyJoystick, B10, EXEC("fnVPOutput(\"System Map On, Off\");"));			// ';'
		}
		else {
			MapKeyUMD(&MyJoystick, B10,
				EXEC("fnVPOutput(\"not used\");"),											// U -
				EXEC("fnVPOutput(\"System Map On, Off\");"),								// M -
				EXEC("fnVPOutput(\"not used\");")											// D - 
				);
		}
		
		if (MapKeyProfile == BASIC) {			// 
			MapKey(&MyJoystick, B11, EXEC("fnVPOutput(\"Show connection status\");"));		// LCTRL+b 
		}
		else {
			MapKeyUMD(&MyJoystick, B11,
				EXEC("fnVPOutput(\"not used\");"),											// U -
				EXEC("fnVPOutput(\"Show connection status\");"),							// M -
				EXEC("fnVPOutput(\"not used\");")											// D -
				);
		}

		if (MapKeyProfile == BASIC) {			// 
			MapKey(&MyJoystick, B12, EXEC("fnVPOutput(\"not used\");"));					//
		}
		else {
			MapKeyUMD(&MyJoystick, B12,
				EXEC("fnVPOutput(\"not used\");"),											// U - 
				EXEC("fnVPOutput(\"Clear the chat box in comms panel\");"),					// M -
				EXEC("fnVPOutput(\"not used\");")											// D -
				);	
		}

		if (MapKeyProfile == BASIC) {			 
			MapKey(&MyJoystick, B13, EXEC("fnVPOutput(\"not used\");"));					//
		}
		else {
			MapKeyUMD(&MyJoystick, B13,
				EXEC("fnVPOutput(\"not used\");"),											// U - 
				EXEC("fnVPOutput(\"Nav Beacon on/off\");"),									// M -
				EXEC("fnVPOutput(\"not used\");")											// D - 
