		MapKey(&MyThrottle, TBTN2, EXEC("fnVPOutput(\"UP Shift button\");"));				//  ** DO NOT TOUCH ** Used as ShiftButton for UMD
		MapKey(&MyThrottle, TBTN3, EXEC("fnVPOutput(\"DOWN Shift button\");"));				//  ** DO NOT TOUCH ** Used as ShiftButton for UMD

		if (MapKeyProfile == BASIC) {			// 
			MapKeyUMD(&MyThrottle, TBTN4, 
				EXEC("fnVPOutput(\"not used\");"),											// U - 
				EXEC("fnVPOutput(\"Engine Boost and S C O\");"),							// LeftShift+'b' - Middle Finger UP
				EXEC("fnVPOutput(\"not used\");")											// D - 
				);
		}
		else {
			MapKeyUMD(&MyThrottle, TBTN4, 
				EXEC("fnVPOutput(\"not used\");"),											// U - 
				EXEC("fnVPOutput(\"Engine Boost and S C O\");"),							// M -
				EXEC("fnVPOutput(\"Increase text to speech volume\");")						// D - 
				);
		}
		
		if (MapKeyProfile == BASIC) {			// 
			MapKeyUMD(&MyThrottle, TBTN5, 
				EXEC("fnVPOutput(\"S R V Hand brake\");"),							// U - 'x'
				EXEC("fnVPOutput(\"Reverse throttle\");"),							// M - NP '*' - Middle Finger DOWN - set to TOGGLE
				EXEC("fnVPOutput(\"not used\");")									// D - 
				);
		}
		else {
			MapKeyUMD(&MyThrottle, TBTN5, 
				EXEC("fnVPOutput(\"S R V Hand brake\");"),							// U - 'x'
				EXEC("fnVPOutput(\"Reverse throttle\");"),							// M - NP '*' - Middle Finger DOWN - set to TOGGLE
				EXEC("fnVPOutput(\"Increase text to speech volume\");")				// D - 
				);
		}

		if (MapKeyProfile == BASIC) {
			MapKeyUMD(&MyThrottle, TLOCK, 
				EXEC("fnVPOutput(\"not used\");"),									// U - 
				EXEC("fnVPOutput(\"Reset Head Look\");"),							// M - '~' - Slew Control - PRESS 
				EXEC("fnVPOutput(\"not used\");")									// D - 
				);
		}
		else{
			MapKeyUMD(&MyThrottle, TLOCK, 
				EXEC("fnVPOutput(\"not used\");"),									// U - 
				EXEC("fnVPOutput(\"Reset Head Look\");"),							// M - 
				EXEC("fnVPOutput(\"Eject all cargo\");")							// D - 'END' key
				);
		}

//===================================================================================================

//		Throttle HAT1 - Middle
//		----------------------

		if (MapKeyProfile == BASIC) {			// 
			MapKey(&MyThrottle, THAT1U, EXEC("fnVPOutput(\"Engage Super Cruise\");"));	// NP '/'	- Numberpad forward slash key 
